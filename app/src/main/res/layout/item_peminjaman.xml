<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cvData"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <TextView
        android:id="@+id/textViewIdPeminjaman"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="TextViewIdBuku"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@+id/imageView2"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/TextViewIdUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TextViewIdUser"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@+id/textViewIdPeminjaman"
        app:layout_constraintTop_toTopOf="@+id/textViewIdPeminjaman" />

    <TextView
        android:id="@+id/textViewIdBuku"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="textViewIdBuku"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/textViewJudul"
        app:layout_constraintStart_toEndOf="@+id/textViewJudul"
        app:layout_constraintTop_toTopOf="@+id/textViewJudul" />

    <TextView
        android:id="@+id/textViewJudul"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="textViewJudul"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/textViewIdPeminjaman"
        app:layout_constraintTop_toBottomOf="@+id/textViewIdPeminjaman" />

    <TextView
        android:id="@+id/textViewStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="status"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/textViewJudul"
        app:layout_constraintTop_toBottomOf="@+id/textViewJudul" />

    <TextView
        android:id="@+id/textViewAwal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="textViewAwal"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/textViewStatus"
        app:layout_constraintStart_toEndOf="@+id/textViewStatus"
        app:layout_constraintTop_toTopOf="@+id/textViewStatus" />

    <TextView
        android:id="@+id/textViewAkhir"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="textViewAkhir"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/textViewAwal"
        app:layout_constraintStart_toEndOf="@+id/textViewAwal"
        app:layout_constraintTop_toTopOf="@+id/textViewAwal" />

    <TextView
        android:id="@+id/TextViewTahunTerbit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="TextView"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@+id/textViewStatus"
        app:layout_constraintTop_toBottomOf="@+id/textViewStatus" />

    <TextView
        android:id="@+id/textViewPenulis"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="TextView"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@+id/textViewJudul"
        app:layout_constraintTop_toBottomOf="@+id/textViewJudul" />

    <TextView
        android:id="@+id/textViewPenerbit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="TextView"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@+id/textViewPenulis"
        app:layout_constraintTop_toBottomOf="@+id/textViewPenulis" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="30dp"
        android:layout_height="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/book" />

    <ImageView
        android:id="@+id/imageViewRemove"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/remove" />

</androidx.constraintlayout.widget.ConstraintLayout>