<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cvData"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <TextView
        android:id="@+id/textViewIdPeminjaman"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="TextViewIdBuku"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@+id/imageView2"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/TextViewIdUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="TextViewIdUser"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/textViewIdPeminjaman"
        app:layout_constraintTop_toTopOf="@+id/textViewIdPeminjaman" />

    <TextView
        android:id="@+id/textViewIdBuku"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TextViewUsername"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@+id/textViewIdPeminjaman"
        app:layout_constraintTop_toBottomOf="@+id/textViewIdPeminjaman" />

    <TextView
        android:id="@+id/TextViewUlasan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="TextViewUlasan"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/TextViewIdUser"
        app:layout_constraintTop_toBottomOf="@+id/TextViewIdUser" />

    <TextView
        android:id="@+id/TextViewRating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="TextViewRating"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@+id/TextViewUlasan"
        app:layout_constraintStart_toEndOf="@+id/TextViewUlasan"
        app:layout_constraintTop_toTopOf="@+id/TextViewUlasan" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="30dp"
        android:layout_height="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/user" />

    <ImageView
        android:id="@+id/imageViewRemove"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/remove" />

    <ImageView
        android:id="@+id/imageViewLike"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/imageViewRemove"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/like" />

</androidx.constraintlayout.widget.ConstraintLayout>